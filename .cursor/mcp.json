{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${env:GH_TOKEN}"
      }
    },
    "ahrena": {
      "command": "ahrena-mcp",
      "args": [
        "--root",
        "${workspaceFolder}"
      ]
    },
    "slack": {
      "url": "https://mcp.slack.com/mcp"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "${env:FIGMA_API_KEY}"
      }
    }
  }
}
