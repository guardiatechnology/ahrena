
__pycache__/
.pytest_cache/
site/

# Local Ahrena installation (generated by install.py)
.ahrena/

# Temporary files
temp.md

# Personal IDE config
.cursor/mcp.json

# Project-level MCP server registry (generated by scripts/install.py).
# Source of truth lives in framework/mcp/<server>.json. See .mcp.json.sample
# for an example of the post-install shape.
.mcp.json

.claude/settings.local.json

# Git worktrees (path defined in paths.worktrees in .ahrena/.directives)
.worktrees/

# Harness runtime artifacts (transient agent worktrees)
.claude/worktrees/

# Claude Code session heartbeat dir (codex-session-tracking §6 — runtime-only)
.ahrena/workflow/sessions/

# AI working memory for plans — provider cache, gitignored
# per `lex-no-plans-under-docs` Rule (a)/(b). The canonical plan body
# lives in the GitHub Plan sub-issue; the local file is a regenerable
# cache materialized by kata-load-plan-from-subissue and flushed by
# kata-flush-plan-to-subissue.
.claude/plans/
.cursor/plans/
# Legacy alias kept for backward compatibility with older repos.
.plans/

# External skill projects — build intermediates (per lex-skill-project-structure)
.build/

# Local environment files (credentials, never commit).
# `.env.*` already covers `.env.local`, `.env.*.local`, etc.
.env
.env.*

# Sample/template env files (committed as documentation)
!.env.sample
!.env.example
.DS_Store
