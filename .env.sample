# Ahrena — environment variables template
#
# Copy this file to .env.local and fill in real values:
#   cp .env.sample .env.local
#
# .env.local is gitignored. NEVER commit real credentials.

# ---------------------------------------------------------------------------
# warrior-argos GitHub App (per Issue #132)
# ---------------------------------------------------------------------------
# Bot identity on PRs/comments: ahrena-warrior-argos[bot]
# GitHub App settings page: https://github.com/organizations/guardiatechnology/settings/apps/ahrena-warrior-argos
#
# How to obtain values:
#   APP_ID         — top of the App settings page
#   INSTALLATION_ID — visible in the URL after install:
#                    https://github.com/organizations/.../installations/{INSTALLATION_ID}
#   PRIVATE_KEY_PATH — path to the .pem file you downloaded; chmod 600
#                      convention: ~/.guardia/{org}/{repo}/warrior-argos.{YYYY-MM-DD}.private-key.pem

AHRENA_WARRIOR_ARGOS_GH_APP_ID=<numeric-app-id>
AHRENA_WARRIOR_ARGOS_GH_INSTALLATION_ID=<numeric-installation-id>
AHRENA_WARRIOR_ARGOS_GH_PRIVATE_KEY_PATH=~/.guardia/guardiatechnology/ahrena/warrior-argos.<YYYY-MM-DD>.private-key.pem
