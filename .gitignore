
__pycache__/
.pytest_cache/
site/

# Local Ahrena installation (generated by install.py)
.ahrena/

# Temporary files
temp.md

# Personal IDE config
.cursor/mcp.json

# Project-level MCP server registry (generated by scripts/install.py).
# Source of truth lives in framework/mcp/<server>.json. See .mcp.json.sample
# for an example of the post-install shape.
.mcp.json

.claude/settings.local.json

# Git worktrees (path defined in paths.worktrees in .ahrena/.directives)
.worktrees/

# Harness runtime artifacts (transient agent worktrees)
.claude/worktrees/

# Claude Code session heartbeat dir (codex-session-tracking §6 — runtime-only)
.ahrena/workflow/sessions/

# AI working memory for plans — provider cache, gitignored
# per `lex-no-plans-under-docs` Rule (a)/(b). The canonical plan body
# lives in the GitHub Plan sub-issue; the local file is a regenerable
# cache materialized by kata-load-plan-from-subissue and flushed by
# kata-flush-plan-to-subissue.
.claude/plans/
.cursor/plans/
# Legacy alias kept for backward compatibility with older repos.
.plans/

# External skill projects — build intermediates (per lex-skill-project-structure)
.build/

# Local environment files (credentials, never commit).
# `.env.*` already covers `.env.local`, `.env.*.local`, etc.
.env
.env.*

# Sample/template env files (committed as documentation)
!.env.sample
!.env.example
.DS_Store

# >>> AHRENA-GITIGNORE >>>
# Managed by Ahrena. Edits inside this block are overwritten on next install.
# Source: framework/.gitignore.sample
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Ahrena: AI-First Capability Framework — `.gitignore` sample
# Recommended entries for projects consuming Ahrena. Copy the lines
# below into your repo's `.gitignore`. Each block is opt-in: only
# include the entries that apply to your project's stack.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ─── Ahrena local installation (mandatory) ─────────────────────
# Materialized by `scripts/install.py` from the framework repo.
# The framework is the source of truth; the local copy is regenerated.
.ahrena/

# ─── Personal IDE config (mandatory) ───────────────────────────
.cursor/mcp.json
.claude/settings.local.json

# ─── Project-level MCP server registry (mandatory) ─────────────
# Generated by `scripts/install.py`. Source of truth lives in
# `framework/mcp/<server>.json` (or .ahrena/mcp/<server>.json override).
.mcp.json

# ─── Git worktrees (mandatory) ─────────────────────────────────
# Path configurable via `paths.worktrees` in `.ahrena/.directives`
# (default `.worktrees/`). See `lex-git-worktrees`.
.worktrees/

# ─── Harness runtime artifacts (mandatory) ─────────────────────
.claude/worktrees/

# ─── Claude Code session heartbeat (recommended) ───────────────
# Runtime-only per `codex-session-tracking` §6.
.ahrena/workflow/sessions/

# ─── AI working memory for plans (mandatory) ──────
# The canonical plan body lives in the corresponding GitHub Issue;
# `.plans/{N}.md` is a regenerable local cache materialized by
# `kata-load-plan-from-issue` and flushed by `kata-flush-plan-to-issue`.
# See `lex-agent-planning` and `codex-agent-planning`.
.plans/

# ─── External skill projects (opt-in, per lex-skill-project-structure) ──
# Build intermediates (gitignored); `.dist` is committed.
.build/

# ─── Local environment files (recommended) ─────────────────────
# Credentials & secrets — NEVER commit. `.env.*` covers `.env.local`,
# `.env.*.local`, `.env.development.local`, etc. Use `.env.sample`
# as a committed template documenting the required variables.
.env
.env.*
!.env.sample
!.env.example

# ─── Stack-specific (opt-in) ───────────────────────────────────
# Add Python / Node / Java / etc. entries below as needed.
# __pycache__/
# .pytest_cache/
# node_modules/
# dist/
# build/
# <<< AHRENA-GITIGNORE <<<
