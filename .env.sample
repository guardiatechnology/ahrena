# Ahrena — environment variables template
#
# Copy this file to .env.local and fill in real values:
#   cp .env.sample .env.local
#
# .env.local is gitignored. NEVER commit real credentials.

# ---------------------------------------------------------------------------
# warrior-argos GitHub App (per Issue #132)
# ---------------------------------------------------------------------------
# Bot identity on PRs/comments: ahrena-warrior-argos[bot]
# GitHub App settings page: https://github.com/organizations/guardiatechnology/settings/apps/ahrena-warrior-argos
#
# How to obtain values:
#   APP_ID         — top of the App settings page
#   INSTALLATION_ID — visible in the URL after install:
#                    https://github.com/organizations/.../installations/{INSTALLATION_ID}
#
# Private key resolution by `scripts/argos/auth.sh` (precedence — first hit wins):
#   1. macOS Keychain entry at service `ahrena.warrior-argos.github-app`
#      Setup once:
#        security add-generic-password \
#          -a "warrior-argos" \
#          -s "ahrena.warrior-argos.github-app" \
#          -w "$(cat /path/to/warrior-argos.<YYYY-MM-DD>.private-key.pem)"
#      In this mode, AHRENA_WARRIOR_ARGOS_GH_PRIVATE_KEY_PATH below may be
#      left commented out — no .pem on disk under ~/.guardia.
#   2. AHRENA_WARRIOR_ARGOS_GH_PRIVATE_KEY_PATH (file fallback, required on
#      Linux/CI or when no Keychain entry exists). Convention:
#      ~/.guardia/{org}/{repo}/warrior-argos.{YYYY-MM-DD}.private-key.pem
#      chmod 600 the file.

AHRENA_WARRIOR_ARGOS_GH_APP_ID=<numeric-app-id>
AHRENA_WARRIOR_ARGOS_GH_INSTALLATION_ID=<numeric-installation-id>

# Uncomment when using file mode (fallback). Leave commented if the key
# lives in the macOS Keychain (mode 1 above).
# AHRENA_WARRIOR_ARGOS_GH_PRIVATE_KEY_PATH=~/.guardia/guardiatechnology/ahrena/warrior-argos.<YYYY-MM-DD>.private-key.pem
